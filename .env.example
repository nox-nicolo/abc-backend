# R2 S3-compatible storage
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Public bucket URL for browser/app reads
BASE_URL=

# Database (optional — falls back to hardcoded URL in core/database.py)
DATABASE_URL=

# JWT — generate a new value with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256

# Firebase Cloud Messaging server credentials
FIREBASE_ADMIN_CREDENTIALS=/path/to/firebase-adminsdk.json
# Optional alternative for hosted environments: paste the full service-account JSON.
FIREBASE_ADMIN_CREDENTIALS_JSON=
